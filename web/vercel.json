{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/ankiweb-proxy/:host(ankiweb\\.net|[a-z0-9-]+\\.ankiweb\\.net)/sync/meta",
            "destination": "/api/ankiweb-proxy?host=:host&path=sync/meta"
        },
        {
            "source": "/ankiweb-proxy/:host(ankiweb\\.net|[a-z0-9-]+\\.ankiweb\\.net)/:path*",
            "destination": "https://:host/:path*"
        },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/((?!reviewer$).*)",
            "headers": [
                { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
                { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
                { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
            ]
        },
        {
            "source": "/reviewer",
            "missing": [{ "type": "header", "key": "user-agent", "value": ".*(Chrome|Firefox)/.*" }],
            "headers": [
                { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
                { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
                { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
            ]
        },
        {
            "source": "/reviewer",
            "has": [{ "type": "header", "key": "user-agent", "value": ".*(Chrome|Firefox)/.*" }],
            "headers": [
                { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
                { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
                { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
            ]
        },
        {
            "source": "/_app/immutable/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/service-worker.js",
            "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
    ]
}
